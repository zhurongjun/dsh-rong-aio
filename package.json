{
  "name": "dsh-rong-aio",
  "version": "0.1.0",
  "description": "自用 DSH 插件：Codex 风格的模型与推理强度选择器。",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhurongjun/dsh-rong-aio.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "docs/installation.md",
    "docs/model-selector.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint --no-error-on-unmatched-pattern --max-warnings 0 .",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern --max-warnings 0 .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "immer": "11.2.9",
    "jsdom": "26.1.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "zod": "4.4.3",
    "zustand": "5.0.16"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts"
}
