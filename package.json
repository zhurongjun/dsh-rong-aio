{
  "name": "dsh-rong-aio",
  "version": "0.1.2",
  "description": "自用 DSH 功能组合包：统一安装，按功能独立启停。",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhurongjun/dsh-rong-aio.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.2-rc.3 || 0.2.2-rc.5"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./model-selector": {
      "types": "./lib/model-selector.d.ts",
      "default": "./lib/model-selector.js"
    },
    "./model-selector/locale/*.json": "./lib/components/model-selector/locale/*.json",
    "./system-inject": {
      "types": "./lib/system-inject.d.ts",
      "default": "./lib/system-inject.js"
    },
    "./system-inject/locale/*.json": "./lib/components/system-inject/locale/*.json",
    "./session-manager": {
      "types": "./lib/session-manager.d.ts",
      "default": "./lib/session-manager.js"
    },
    "./session-manager/locale/*.json": "./lib/components/session-manager/locale/*.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "scripts/ui-contract.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint --no-error-on-unmatched-pattern --max-warnings 0 . && pnpm check:boundaries",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern --max-warnings 0 . && pnpm check:boundaries",
    "check": "pnpm format:check && pnpm lint && pnpm check:ui && pnpm typecheck && pnpm test",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm test:node && pnpm test:ui",
    "test:node": "node --experimental-strip-types --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "test:ui": "node --test tests/bombadil/run.mjs",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.8.0",
    "@babel/parser": "7.29.12",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-team": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "clsx": "2.1.1",
    "css-tree": "3.2.1",
    "esbuild": "0.28.2",
    "immer": "11.2.9",
    "oxlint": "1.81.0",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.6",
    "zustand": "5.0.16"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    }
  },
  "homepage": "https://github.com/zhurongjun/dsh-rong-aio#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "model-selector",
    "system-prompt"
  ]
}
