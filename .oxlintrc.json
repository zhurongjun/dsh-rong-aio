{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": false,
    "node": false
  },
  "rules": {
    "no-unused-vars": "error",
    "no-debugger": "error",
    "no-undef": "error",
    "eqeqeq": "error",
    "typescript/no-require-imports": "error",
    "no-restricted-properties": [
      "error",
      {
        "property": "useEffect",
        "message": "禁止使用 useEffect"
      },
      {
        "property": "useLayoutEffect",
        "message": "禁止使用 useLayoutEffect"
      },
      {
        "property": "useInsertionEffect",
        "message": "禁止使用 useInsertionEffect"
      }
    ]
  },
  "ignorePatterns": [
    "agent_temp/**",
    "node_modules/**",
    ".pnpm-store/**",
    ".cache/**",
    ".local/**",
    ".dsh-dev/**",
    "coverage/**",
    "lib/**",
    "dist/**"
  ],
  "overrides": [
    {
      "files": ["tests/bombadil/**/*.{jsx,tsx}", "tests/bombadil/primitives.mjs"],
      "env": { "browser": true }
    },
    {
      "files": ["src/**/host/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/**/client/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"],
      "env": {
        "browser": true
      },
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect", "useInsertionEffect"],
                "message": "禁止导入 React Effect Hook"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/shared/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"],
      "rules": {
        "import/no-nodejs-modules": "error"
      }
    },
    {
      "files": [
        "tools/**/*.{js,mjs,ts}",
        "tests/components/**/*.{js,mjs,ts,tsx}",
        "tests/contracts/**/*.{js,mjs,ts,tsx}",
        "tests/integration/**/*.{js,mjs,ts,tsx}",
        "tests/bombadil/run.mjs",
        "tests/bombadil/driver.mjs",
        "tests/bombadil/fixture.mjs"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
