{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": false,
    "node": false
  },
  "rules": {
    "no-unused-vars": "error",
    "no-debugger": "error",
    "no-undef": "error",
    "eqeqeq": "error",
    "typescript/no-require-imports": "error",
    "no-restricted-properties": [
      "error",
      {
        "property": "useEffect",
        "message": "禁止使用 useEffect；请改用 Store 订阅生命期（withLifecycle / useStore）、事件回调或受管 DOM 控制器。"
      },
      {
        "property": "useLayoutEffect",
        "message": "禁止使用 useLayoutEffect；请改用 React 18 Callback Ref 或受管 DOM 控制器。"
      },
      {
        "property": "useInsertionEffect",
        "message": "禁止使用 useInsertionEffect；样式请统一在客户端入口通过 mountStyle 挂载。"
      }
    ]
  },
  "ignorePatterns": [
    "agent_temp/**",
    "node_modules/**",
    ".pnpm-store/**",
    ".cache/**",
    ".local/**",
    ".dsh-dev/**",
    "coverage/**",
    "lib/**",
    "dist/**"
  ],
  "overrides": [
    {
      "files": ["tests/bombadil/workbench.jsx"],
      "env": { "browser": true }
    },
    {
      "files": ["src/**/host/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"],
      "env": {
        "node": true
      },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)client(/|$)",
                "message": "Host 不得导入 Client；共享类型和协议应放入所属组件的 shared。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/client/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"],
      "env": {
        "browser": true
      },
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect", "useInsertionEffect"],
                "message": "禁止导入 Effect 系列 Hook；请使用 Store 订阅生命期（withLifecycle / useStore）、事件回调或受管 DOM 控制器。"
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)host(/|$)",
                "message": "Client 不得导入 Host；共享类型和协议应放入所属组件的 shared。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/shared/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(host|client)(/|$)",
                "message": "Shared 必须与运行侧无关，不得导入 Host 或 Client。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/**/*.{js,mjs,ts}", "tests/**/*.{js,mjs,ts,tsx}"],
      "env": {
        "node": true
      }
    }
  ]
}
