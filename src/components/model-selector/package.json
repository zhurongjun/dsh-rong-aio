{
  "name": "dsh-rong-aio-model-selector",
  "version": "0.1.0",
  "description": "模型、推理强度与 Fast 速度选择器。",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
