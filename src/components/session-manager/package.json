{
  "name": "dsh-rong-aio-session-manager",
  "version": "0.2.8",
  "description": "会话归档、复原与磁盘清理。",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
