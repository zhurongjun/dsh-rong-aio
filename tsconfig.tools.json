{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "lib": ["ES2024", "ESNext.Array", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./agent_temp/tsbuildinfo/tools.tsbuildinfo"
  },
  "include": ["tools/**/*.ts", "tools/**/*.d.ts", "tests/**/*.ts"]
}
